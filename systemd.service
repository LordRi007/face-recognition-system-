# Systemd Service Unit for FRMS
# Place at: /etc/systemd/system/frms.service
# Commands:
#   sudo systemctl daemon-reload
#   sudo systemctl enable frms
#   sudo systemctl start frms
#   sudo systemctl status frms

[Unit]
Description=Face Recognition Management System (FRMS) Gunicorn Daemon
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/frms
Environment="PATH=/var/www/frms/venv/bin"
EnvironmentFile=/var/www/frms/.env
ExecStart=/var/www/frms/venv/bin/gunicorn --config /var/www/frms/gunicorn.conf.py run:app

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true

# Security Hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
