# ============================================================
# Face Recognition Management System (FRMS) - Environment Config
# ============================================================

# Flask Security & Session
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-insecure-flask-secret-key-change-in-production-frms-2026
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Database Configuration (SQLite default for development, PostgreSQL for production)
# For local SQLite: sqlite:///face_recognition.db
# For PostgreSQL: postgresql+psycopg2://frms_user:securepassword@localhost:5432/frms_db
DATABASE_URL=sqlite:///face_recognition.db

# Biometric Template Encryption (Fernet / AES-256 Key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=W3dYvGqgV4u2N_VjS4w1n-X98oQ5P6a0M8b4Z2l1Y6A=

# AI Model & Biometrics Parameters
# Available models: Facenet512, Facenet, VGG-Face, ArcFace
FACENET_MODEL_NAME=Facenet512
# Detectors: opencv, ssd, mtcnn, retinaface
FACE_DETECTOR_BACKEND=opencv
FACE_DISTANCE_METRIC=cosine
# Recommended threshold for Facenet512 with cosine distance is 0.30
FACE_MATCH_THRESHOLD=0.30

# Image Quality Gates (Blur & Illumination Validation)
QUALITY_MIN_BLUR_SCORE=80.0
QUALITY_MIN_BRIGHTNESS=40.0
QUALITY_MAX_BRIGHTNESS=225.0

# Rate Limiting & Lockout
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# Audit & Retention
AUDIT_LOG_RETENTION_DAYS=365
ATTENDANCE_LATE_THRESHOLD_TIME=09:15:00
